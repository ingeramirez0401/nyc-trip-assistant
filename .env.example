# Supabase Configuration (públicas: se inlinean en el bundle del navegador)
VITE_SUPABASE_URL=https://devsupabase.cambios-app.com
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# hCaptcha (pública, sitekey) — opcional. Si se deja vacía, el widget no
# aparece y el login/registro sigue funcionando sin captcha. Para que
# realmente proteja el registro, además hay que activar
# GOTRUE_SECURITY_CAPTCHA_* en el stack de Supabase (fuera de este repo)
# con el secret key correspondiente de hcaptcha.com.
VITE_HCAPTCHA_SITE_KEY=

# OpenAI Configuration — SECRETA, solo la usa server/index.js (backend).
# NUNCA usar el prefijo VITE_ aquí: eso la expondría en el navegador.
# Nombre namespaced a propósito (evita colisión con un OPENAI_API_KEY
# genérico que puedas tener seteado globalmente, p.ej. por Ollama).
TRIPPULSE_OPENAI_API_KEY=your_openai_api_key_here

# Google Places API — SECRETA, solo la usa server/placesRoutes.js.
# Restringida en Google Cloud Console a "Places API (New)" únicamente.
GOOGLE_PLACES_API_KEY=

# Correo del admin de la plataforma -- ahí llegan las notificaciones de
# nuevas solicitudes de agencia (server/agencyRequestRoutes.js).
ADMIN_NOTIFICATION_EMAIL=

# URL pública de la app -- SECRETA no es, pero es server-only (runtime, no
# VITE_). Se usa para armar los links de los emails (aprobar agencia, canjear
# licencia) de forma estable, sin depender del header Origin de la petición
# que disparó el envío. Sin esto, cae de vuelta a Origin/Host de la request
# (útil en dev, pero no confiable para producción).
APP_PUBLIC_URL=https://travel.nodalyst.ai
